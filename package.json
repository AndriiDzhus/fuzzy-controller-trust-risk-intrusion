{
  "name": "fuzzy-controller-trust-risk-intrusion",
  "version": "1.0.0",
  "description": "Multi-Controller Fuzzy Inference Platform for System Security Assessment",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:pages": "node scripts/build-pages.js",
    "data:prepare": "python3 scripts/data/prepare_datasets.py --datasets ../../Dicertation/DATASETS",
    "data:app": "python3 scripts/data/make_app_datasets.py",
    "train:security": "node scripts/train-security.js",
    "train:intrusion": "node scripts/train-intrusion.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "fuzzy",
    "logic",
    "security",
    "trust index",
    "risk assessment",
    "intrusion detection",
    "controller",
    "nodejs"
  ],
  "author": "Andrii Dzhus",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "fuzzyis": "^1.0.2",
    "katex": "^0.18.5"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  }
}
